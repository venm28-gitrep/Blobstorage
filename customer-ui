import os 
import requests 
from flask import Flask, render_template_string, request 
app = Flask(__name__) 
BACKEND_URL = os.environ.get( 
"BACKEND_URL", 
"http://localhost:8000" 
) 
PAGE = """ 
<!doctype html> 
<title>Customer Management</title> 
<h2>Add Customer</h2> 
<form method="post"> 
    <input name="id" type="number" placeholder="Customer ID" 
required><br><br> 
 
    <input name="name" placeholder="Name" required><br><br> 
 
    <input name="salary" type="number" step="0.01" 
           placeholder="Salary" required><br><br> 
 
    <textarea name="address" 
              placeholder="Address" 
              required></textarea><br><br> 
 
    <button type="submit">Save Customer</button> 
</form> 
 
{% if message %} 
<p>{{ message }}</p> 
{% endif %} 
""" 
 
 
@app.route("/", methods=["GET", "POST"]) 
def customer_form(): 
    message = None 
 
    if request.method == "POST": 
        payload = { 
            "id": int(request.form["id"]), 
            "name": request.form["name"].strip(), 
            "salary": float(request.form["salary"]), 
            "address": request.form["address"].strip(), 
        } 
 
        try: 
            response = requests.post( 
                f"{BACKEND_URL.rstrip('/')}/customers", 
                json=payload, 
                timeout=30, 
            ) 
 
            data = response.json() 
 
            message = ( 
                data.get("message") 
                if response.ok 
                else data.get("detail", data) 
            ) 
 
        except requests.RequestException as ex: 
            message = f"Backend request failed: {ex}" 
 
    return render_template_string(PAGE, message=message) 
 
 
@app.get("/health") 
def health(): 
    return {"status": "ok"} 
 
 
if __name__ == "__main__": 
    app.run(host="0.0.0.0", port=5000)